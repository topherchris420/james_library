    },
    "title": "Citation gate rejects fabricated quotes and accepts verbatim ones",
    "variables": {
      "controls": [
        "fixed corpus snapshot (hashed)",
        "fixed seed",
        "oracle-labelled ground truth"
      ],
      "dependent": [
        "acceptance by verify_quote",
        "call latency"
      ],
      "independent": [
        "quote construction class"
      ]
    }
  },
