        "unit": "count"
      },
      {
        "description": "False-accept rate over all fabricated cases.",
        "deterministic": true,
        "name": "fabricated_acceptance_rate",
        "unit": "ratio"
      },
      {
        "description": "False-accept rate for one-word substitutions.",
        "deterministic": true,
        "name": "substituted_acceptance_rate",
        "unit": "ratio"
      },
      {
