      ],
      "repository": "topherchris420/james_library"
    },
    "title": "CIRCLE analysis error rates on seeded simulated controls",
    "variables": {
      "controls": [
        "same manifest for all trials",
        "disjoint seeds per condition",
        "fixed noise and phantom"
      ],
      "dependent": [
        "analysis conclusion"
      ],
      "independent": [
        "true simulated effect (-6.5 ohm vs 0)"
      ]
    }
  },
